# =============================================================================
# backend/.env  —  PRODUCCIÓN (servidor BACKEND)
# Copia este archivo a  backend/.env  y reemplaza los <PLACEHOLDERS>.
# NO se sube a git. Genera JWT_SECRET con:  openssl rand -hex 32
# =============================================================================

NODE_ENV=production
PORT=3001

# PostgreSQL en RDS Aurora (endpoint del cluster, usuario y clave reales).
# El endpoint de Aurora termina en .cluster-xxxx.<region>.rds.amazonaws.com
DATABASE_URL="postgresql://<RDS_USER>:<RDS_PASS>@<ENDPOINT>.cluster-xxxx.<region>.rds.amazonaws.com:5432/dominiohackctf?schema=public"

# MongoDB Atlas M0 (cadena SRV que da Atlas; en Atlas: Network Access -> allowlist
# con la Elastic IP del backend). La base va al final de la ruta (/dominiohackctf).
MONGO_URI="mongodb+srv://<ATLAS_USER>:<ATLAS_PASS>@<CLUSTER>.mongodb.net/dominiohackctf?retryWrites=true&w=majority"

# Un solo dominio detrás de Nginx (same-origin). Dominio del proyecto:
CORS_ORIGIN=https://dominiohackctf.cl
FRONTEND_URL=https://dominiohackctf.cl
COOKIE_DOMAIN=dominiohackctf.cl

# JWT / sesiones
JWT_SECRET=<PEGAR_openssl_rand_hex_32>
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# Google OAuth (callback público vía Nginx → backend).
# Autoriza este redirect URI en Google Cloud Console.
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_CALLBACK_URL=https://dominiohackctf.cl/v1/auth/google/callback

# WireGuard (modo producción). Los dos valores WG_SERVER_* los imprime
# UP/backend/02-wireguard-server.sh.
WG_MODE=cli
WG_INTERFACE=wg0
WG_SERVER_PUBLIC_KEY=<CLAVE_PUBLICA_DEL_SERVIDOR>
WG_SERVER_ENDPOINT=<ELASTIC_IP_BACKEND>:51820
WG_PEER_SUBNET_BASE=10.10.0
WG_PEER_IP_START=2
WG_CLIENT_ALLOWED_IPS=10.20.0.0/16
# WG_CLIENT_DNS=1.1.1.1
WG_USE_SUDO=true

# Motor de labs. Ajusta LAB_MAX_CONCURRENT a la RAM: ~ (RAM libre) / LAB_MEMORY_MB.
# En un t3.small (2 GB) mantenlo bajo (2); el swap cubre picos, no uso sostenido.
FIREWALL_MODE=cli
LAB_SUBNET_PREFIX=10.20
LAB_DURATION_MIN=60
LAB_EXTENSION_MIN=30
LAB_MAX_DURATION_MIN=120
LAB_MAX_CONCURRENT=2
LAB_MEMORY_MB=512
LAB_CPUS=0.5
