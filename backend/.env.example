# Copiar a .env y ajustar. Los valores por defecto coinciden con docker/docker-compose.yml (solo dev).

NODE_ENV=development
PORT=3001

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://dhctf:dhctf@127.0.0.1:5432/dominiohackctf?schema=public"

# MongoDB (eventos y logs)
MONGO_URI="mongodb://dhctf:dhctf@127.0.0.1:27017/dominiohackctf?authSource=admin"

# Origen permitido por CORS (frontend Next.js)
CORS_ORIGIN=http://localhost:3000

# URL del frontend (redirección tras login con Google)
FRONTEND_URL=http://localhost:3000

# JWT. Generar el secreto con: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
# Dominio de la cookie del refresh token (solo producción, p. ej. .dominiohackctf.com)
#COOKIE_DOMAIN=

# Google OAuth (opcional). Callback autorizado en Google Cloud Console:
# http://localhost:3001/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback
